{
  "expo": {
    "name": "daydump-app",
    "slug": "daydump-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daydump.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DayDump scans your photos locally to curate aesthetic Instagram carousels and suggest daily themes.",
        "NSPhotoLibraryAddUsageDescription": "DayDump needs permission to save your curated carousel slides to your camera roll."
      }
    },
    "android": {
      "package": "com.daydump.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow DayDump to access your photos to curate daily aesthetic carousels.",
          "savePhotosPermission": "Allow DayDump to save curated posts to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
